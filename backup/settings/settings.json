{
  "permissions": {
    "allow": [
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/claude-config/scripts/sync-to-git.sh >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__claude_ai_Todoist__add-tasks|mcp__claude_ai_Todoist__update-tasks|mcp__claude_ai_Todoist__reschedule-tasks",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/todoist_calendar_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Notion__notion-create-pages|mcp__claude_ai_Notion__notion-update-page",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/content_safety_gate.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}

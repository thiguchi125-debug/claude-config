<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<title>thumb 16x9 3split（西野公園プール型）</title>
<!-- 目標形＝references/thumbnail/model_kusakawa_nishino_pool_2026-09-14.jpg。座標は同画像の採寸値。
     {{…}} は make_thumb.py が差し替える。直接いじるのは写真の位置と大きさ（--site-*／--me-*）だけにする -->
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { width:1600px; height:900px; overflow:hidden; background:#1f5a3a; }
  body {
    font-family:"Hiragino Sans","Hiragino Kaku Gothic ProN",sans-serif;
    font-feature-settings:"palt" 1;
    -webkit-font-smoothing:antialiased;
  }
  .stage { position:relative; width:1600px; height:900px; overflow:hidden; background:#1f5a3a; }

  /* 左：現場写真（無加工・暗幕なし）。右辺は右下がりの斜め 335→395 */
  .site {
    position:absolute; left:0; top:0; width:400px; height:900px;
    background:url("{{SITE_PHOTO}}") {{SITE_POS}} / {{SITE_SIZE}} no-repeat;
    clip-path:polygon(0 0, 335px 0, 395px 900px, 0 900px);
  }
  /* 右：本人写真の平行四辺形。左辺945→1005／右辺1395→1450。右端は緑を残す */
  .me {
    position:absolute; left:0; top:0; width:1600px; height:900px;
    background:url("{{ME_PHOTO}}") {{ME_X}}px {{ME_Y}}px / {{ME_W}}px auto no-repeat;
    clip-path:polygon(945px 0, 1395px 0, 1450px 900px, 1005px 900px);
  }

  .tx { position:absolute; left:432px; top:79px; width:500px; }

  .place {
    display:inline-block; border:4px solid #fff; border-radius:48px;
    padding:8px 30px 9px; font-size:54px; font-weight:900; line-height:1.2;
    letter-spacing:.02em; color:#fff; white-space:nowrap;
  }
  .l1  { margin-top:46px; font-size:{{L1_PX}}px; font-weight:900; line-height:1.0;
         letter-spacing:.01em; color:#fff; white-space:nowrap; }
  .key { margin-top:18px; font-size:{{KEY_PX}}px; font-weight:900; line-height:1.0;
         letter-spacing:-.01em; color:#fad64d; white-space:nowrap; }
  .ask {
    display:inline-block; margin-top:44px; background:#fff; border-radius:8px;
    padding:14px 22px 16px; font-size:{{ASK_PX}}px; font-weight:900; line-height:1.2;
    letter-spacing:.02em; color:#1f5a3a; white-space:nowrap;
  }
  .role { margin-top:38px; font-size:58px; font-weight:800; line-height:1.1; letter-spacing:.01em; color:#fff; }
  .name { margin-top:4px; font-size:74px; font-weight:900; line-height:1.1; letter-spacing:.02em; color:#fff; }
</style>
</head>
<body>
<div class="stage">
  <div class="site"></div>
  <div class="me"></div>
  <div class="tx">
    <div class="place">{{PLACE}}</div>
    <div class="l1">{{LINE1}}</div>
    <div class="key">{{KEY}}</div>
    <div><div class="ask">{{ASK}}</div></div>
    <div class="role">亀山市議会議員</div>
    <div class="name">草川たくや</div>
  </div>
</div>
</body>
</html>
